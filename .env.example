# ══════════════════════════════════════════════════════════════
#  AIMARKETNM_BOT — muhit o'zgaruvchilari
#  (multi-tenant: bitta jarayon, ko'p biznes — saas/README.md ga qarang)
# ══════════════════════════════════════════════════════════════

# ── MAJBURIY ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # asosiy bot @AIMARKETNM_BOT
ANTHROPIC_API_KEY=           # platforma darajasida (barcha bizneslar uchun)

# 🔐 Bito API kalitlari shu bilan shifrlanadi. BERILMASA avtomatik
# yaratiladi va .master_key fayliga yoziladi — volume yo'qolsa barcha
# mijozlarning Bito kalitlari o'qib bo'lmas holga keladi. MAJBURIY.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# ── LITSENZIYA BOTI (@BMPAINM_BOT) ─────────────────────────────
ADMIN_BOT_TOKEN=             # litsenziya botining tokeni
SAAS_OWNER_ID=               # sizning Telegram ID — faqat siz kira olasiz
MAIN_BOT_USERNAME=AIMARKETNM_BOT   # havolalar shu nom bilan yasaladi

# ── TENANT SOZLAMALARI ─────────────────────────────────────────
DEFAULT_TENANT=bonnu         # kontekst aniqlanmasa ishlatiladigan biznes
CENTRAL_DB_PATH=/data/central.db
TENANTS_DIR=/data/tenants
TRIAL_DAYS=14
GRACE_DAYS=3
AI_DAILY_LIMIT=300           # bir biznesga kuniga AI chaqiruv limiti
# TENANT_STRICT=1            # kontekstsiz DB murojaatlarini loglaydi (debug)

# ── ESKI, BIR TENANTLI REJIM ───────────────────────────────────
# Migratsiyadan KEYIN bularni O'CHIRING — aks holda barcha bizneslarga
# bir xil qiymat qo'llanadi. Sozlamalar endi markaziy bazadan olinadi.
# SUPER_ADMIN_ID=
# BITO_API_KEY=
# BITO_ORG_ID=
# BITO_WAREHOUSE_ID=
# BITO_SALE_PRICE_ID=
# BITO_PLU_FIELD_ID=
# BITO_KG_MEASURE_ID=
# REVIEW_SECRET=

# ── IXTIYORIY ──────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
APP_JWT_SECRET=              # mobil ilova/dashboard uchun uzun tasodifiy matn
IG_USER_ID=
IG_ACCESS_TOKEN=
PORT=8080
